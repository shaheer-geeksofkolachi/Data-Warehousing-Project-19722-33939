    {
      "id": 8,
      "title": "Average query execution time per dashboard widget (ms, log scale) \u2014 by tier",
      "type": "barchart",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "sdi-postgres"
      },
      "description": "Recommended chart: identifies unoptimised joins. Tall red bars = row-store scans of 500k+ rows.",
      "gridPos": {
        "x": 0,
        "y": 7,
        "w": 24,
        "h": 12
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "sdi-postgres"
          },
          "rawSql": "SELECT query_id || ' ' || left(widget_name, 38) AS widget, round(avg(exec_ms) FILTER (WHERE tier='oltp_staging')::numeric,1) AS \"Postgres staging (OLTP)\",\n                    round(avg(exec_ms) FILTER (WHERE tier='star_schema')::numeric,1) AS \"Star schema\",\n                    round(avg(exec_ms) FILTER (WHERE tier='star_optimized')::numeric,1) AS \"Optimised star\"\n                       FROM ops.query_log WHERE status='SUCCESS' AND caller='benchmark' AND refresh_tag IN (${refresh:sqlstring})\n                       GROUP BY query_id, widget_name ORDER BY query_id",
          "format": "table",
          "rawQuery": true,
          "editorMode": "code"
        }
      ],
