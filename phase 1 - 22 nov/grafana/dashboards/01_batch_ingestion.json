  "annotations": {
    "list": [
      {
        "name": "Refresh cycles",
        "datasource": {
          "type": "grafana-postgresql-datasource",
          "uid": "sdi-postgres"
        },
        "enable": true,
        "iconColor": "orange",
        "target": {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "sdi-postgres"
          },
          "rawSql": "SELECT min(start_ts) AS time, 'Refresh ' || refresh_tag AS text FROM ops.batch_load_log GROUP BY refresh_tag",
          "format": "table",
          "rawQuery": true,
          "editorMode": "code"
        }
      }
    ]
