    {
      "id": 8,
      "title": "Batch load duration per Excel source (seconds)",
      "type": "barchart",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "sdi-postgres"
      },
      "description": "Batch Load Duration = end_ts - start_ts per sheet (read + validate + insert). The 500k-row sales sheet dominates the BASE load.",
      "gridPos": {
        "x": 0,
        "y": 7,
        "w": 12,
        "h": 11
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "sdi-postgres"
          },
          "rawSql": "SELECT source_name || ' [' || refresh_tag || ']' AS source, round(duration_s, 2) AS \"duration (s)\"\n                       FROM ops.batch_load_log WHERE refresh_tag IN (${refresh:sqlstring}) ORDER BY duration_s DESC",
          "format": "table",
          "rawQuery": true,
          "editorMode": "code"
        }
      ],
      "options": {
        "orientation": "horizontal",
        "showValue": "auto",
        "groupWidth": 0.75,
        "barWidth": 0.9,
        "stacking": "none",
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi"
        },
        "xTickLabelRotation": 0
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "fillOpacity": 85,
            "lineWidth": 0
          },
          "unit": "s"
        },
        "overrides": []
      }
    },
    {
      "id": 9,
      "title": "Time breakdown per source (BASE load): read vs validate vs insert",
      "type": "barchart",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "sdi-postgres"
      },
      "description": "Where the time goes: parsing Excel is the most expensive step; COPY into Postgres is cheap.",
      "gridPos": {
        "x": 12,
        "y": 7,
        "w": 12,
        "h": 11
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "sdi-postgres"
          },
          "rawSql": "SELECT source_name AS source, round(read_s,2) AS \"read Excel\", round(validate_s,2) AS \"validate\",\n                              round(insert_s,2) AS \"insert (COPY)\"\n                       FROM ops.batch_load_log WHERE refresh_tag = 'BASE' ORDER BY duration_s DESC",
          "format": "table",
          "rawQuery": true,
          "editorMode": "code"
        }
      ],
      "options": {
        "orientation": "horizontal",
        "showValue": "auto",
        "groupWidth": 0.75,
        "barWidth": 0.9,
        "stacking": "normal",
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi"
        },
        "xTickLabelRotation": 0
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "fillOpacity": 85,
            "lineWidth": 0
          },
          "unit": "s"
        },
        "overrides": []
      }
    },
    {
      "id": 10,
      "title": "Rows processed per batch (log scale) by refresh",
      "type": "barchart",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "sdi-postgres"
      },
      "description": "Rows processed per batch = len(df) after reading each sheet.",
      "gridPos": {
        "x": 0,
        "y": 18,
        "w": 12,
        "h": 9
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "sdi-postgres"
          },
          "rawSql": "SELECT source_name AS source,\n                              sum(rows_read) FILTER (WHERE refresh_tag='BASE') AS \"BASE\",\n                              sum(rows_read) FILTER (WHERE refresh_tag='R1') AS \"R1\",\n                              sum(rows_read) FILTER (WHERE refresh_tag='R2') AS \"R2\"\n                       FROM ops.batch_load_log GROUP BY 1 ORDER BY 1",
          "format": "table",
          "rawQuery": true,
          "editorMode": "code"
        }
      ],
      "options": {
        "orientation": "vertical",
        "showValue": "auto",
        "groupWidth": 0.75,
        "barWidth": 0.9,
        "stacking": "none",
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi"
        },
        "xTickLabelRotation": -30
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "fillOpacity": 85,
            "lineWidth": 0,
            "scaleDistribution": {
              "type": "log",
              "log": 10
            }
          }
        },
        "overrides": []
      }
    },
    {
      "id": 11,
      "title": "Rejected rows by validation rule",
      "type": "barchart",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "sdi-postgres"
      },
      "description": "Rules: non-null keys, MedicineID in master, price > 0, valid dates, net = gross - discount, sensor range, duplicate keys.",
      "gridPos": {
        "x": 12,
        "y": 18,
        "w": 12,
        "h": 9
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "sdi-postgres"
          },
          "rawSql": "SELECT reason_code AS rule, count(*) FILTER (WHERE ingest_mode='batch') AS \"batch files\",\n                              count(*) FILTER (WHERE ingest_mode='stream') AS \"stream events\"\n                       FROM rejects.rejected_rows GROUP BY 1 ORDER BY 2 DESC",
          "format": "table",
          "rawQuery": true,
          "editorMode": "code"
        }
      ],
      "options": {
        "orientation": "vertical",
        "showValue": "auto",
        "groupWidth": 0.75,
        "barWidth": 0.9,
        "stacking": "none",
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi"
        },
        "xTickLabelRotation": -30
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "fillOpacity": 85,
            "lineWidth": 0
          }
        },
        "overrides": []
      }
    },
    {
      "id": 12,
      "title": "Batch load log (latest first)",
      "type": "table",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "sdi-postgres"
      },
      "description": "",
      "gridPos": {
        "x": 0,
        "y": 27,
        "w": 16,
        "h": 9
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "sdi-postgres"
          },
          "rawSql": "SELECT start_ts AS \"start\", refresh_tag AS refresh, file_name AS \"file [sheet]\", rows_read, rows_loaded,\n                           rows_rejected, rows_duplicate, round(duration_s,2) AS duration_s, rows_per_sec, status, dag_run_id\n                    FROM ops.batch_load_log WHERE refresh_tag IN (${refresh:sqlstring}) ORDER BY load_id DESC",
          "format": "table",
          "rawQuery": true,
          "editorMode": "code"
        }
      ],
      "options": {
        "showHeader": true,
        "cellHeight": "sm",
        "footer": {
          "show": false
        }
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto",
            "cellOptions": {
              "type": "auto"
            }
          }
        },
        "overrides": []
      }
    },
