        "query": "SELECT DISTINCT refresh_tag FROM ops.batch_load_log WHERE refresh_tag IS NOT NULL ORDER BY 1",
        "definition": "SELECT DISTINCT refresh_tag FROM ops.batch_load_log ORDER BY 1",
