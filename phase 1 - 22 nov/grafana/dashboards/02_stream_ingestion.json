            "uid": "sdi-postgres"
          },
          "rawSql": "SELECT bucket_ts AS time, 'malformed' AS metric, events_malformed AS value FROM ops.stream_metrics\n                        WHERE $__timeFilter(bucket_ts) AND events_malformed > 0\n                        UNION ALL SELECT bucket_ts, 'duplicate', events_duplicate FROM ops.stream_metrics\n                        WHERE $__timeFilter(bucket_ts) AND events_duplicate > 0 ORDER BY 1",
