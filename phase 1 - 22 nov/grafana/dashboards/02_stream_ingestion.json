    {
      "id": 8,
      "title": "Stream throughput (events/sec) during the simulation",
      "type": "timeseries",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "sdi-postgres"
      },
      "description": "Recommended chart: events committed per second. A flat line near the target rate = stable pipeline.",
      "gridPos": {
        "x": 0,
        "y": 7,
        "w": 16,
        "h": 10
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "sdi-postgres"
          },
          "rawSql": "SELECT bucket_ts AS time, s.refresh_tag AS metric, m.events_ingested AS value\n                        FROM ops.stream_metrics m JOIN ops.stream_session s USING (session_id)\n                        WHERE $__timeFilter(bucket_ts) ORDER BY 1",
          "format": "time_series",
          "rawQuery": true,
          "editorMode": "code"
        }
