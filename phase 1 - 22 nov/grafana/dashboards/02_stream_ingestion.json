            "type": "grafana-postgresql-datasource",
            "uid": "sdi-postgres"
          },
          "rawSql": "SELECT sum(events_ingested) FROM ops.stream_session WHERE refresh_tag IN (${refresh:sqlstring})",
          "format": "table",
          "rawQuery": true,
          "editorMode": "code"
