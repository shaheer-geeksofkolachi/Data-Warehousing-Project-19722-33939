      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "sdi-postgres"
          },
          "rawSql": "SELECT bucket_ts AS time, 'avg ' || s.refresh_tag AS metric,\n                               m.latency_sum_ms / nullif(m.events_ingested,0) AS value\n                        FROM ops.stream_metrics m JOIN ops.stream_session s USING (session_id)\n                        WHERE $__timeFilter(bucket_ts) AND m.events_ingested > 0 ORDER BY 1",
          "format": "time_series",
          "rawQuery": true,
          "editorMode": "code"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "sdi-postgres"
          },
          "rawSql": "SELECT bucket_ts AS time, 'max ' || s.refresh_tag AS metric,\n                                              m.latency_max_ms AS value FROM ops.stream_metrics m\n                                              JOIN ops.stream_session s USING (session_id)\n                                              WHERE $__timeFilter(bucket_ts) AND m.events_ingested > 0 ORDER BY 1",
          "format": "time_series",
          "rawQuery": true,
          "editorMode": "code"
