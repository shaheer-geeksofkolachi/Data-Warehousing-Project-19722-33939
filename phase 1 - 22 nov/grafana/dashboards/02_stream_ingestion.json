      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "sdi-postgres"
          },
          "rawSql": "SELECT session_id, refresh_tag, start_ts, round(duration_s,1) AS duration_s,\n                     events_sent, events_ingested, events_malformed, events_duplicate, round(throughput_eps,1) AS eps,\n                     round(avg_latency_ms,1) AS avg_ms, round(p95_latency_ms,1) AS p95_ms\n                     FROM ops.stream_session WHERE refresh_tag IN (${refresh:sqlstring}) ORDER BY start_ts DESC",
          "format": "table",
          "rawQuery": true,
          "editorMode": "code"
