    {
      "id": 12,
      "title": "Malformed & duplicate events per second",
      "type": "timeseries",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "sdi-postgres"
      },
      "description": "",
      "gridPos": {
