    {
      "id": 10,
      "title": "End-to-end latency per second (avg and max, ms)",
      "type": "timeseries",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "sdi-postgres"
      },
      "description": "",
      "gridPos": {
        "x": 0,
        "y": 17,
