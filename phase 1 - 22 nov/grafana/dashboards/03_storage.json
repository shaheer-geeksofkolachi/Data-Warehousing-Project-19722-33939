    {
      "id": 10,
      "title": "Row store vs column store: same data, different footprint (MB)",
      "type": "barchart",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "sdi-postgres"
      },
      "description": "",
      "gridPos": {
        "x": 16,
        "y": 7,
        "w": 8,
        "h": 10
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "sdi-postgres"
          },
          "rawSql": "SELECT 'Sales' AS dataset,\n                         max(size_mb) FILTER (WHERE table_name='stg_pharmacy_sales_data') AS \"Postgres staging (row store)\",\n                         max(size_mb) FILTER (WHERE table_name='fact_sales') AS \"DuckDB fact (columnar)\"\n                       FROM ops.storage_snapshot WHERE snapshot_ts = (SELECT max(snapshot_ts) FROM ops.storage_snapshot)\n                       UNION ALL\n                       SELECT 'Hospital demand', max(size_mb) FILTER (WHERE table_name='stg_hospital_demand_data'),\n                              max(size_mb) FILTER (WHERE table_name='fact_hospital_demand')\n                       FROM ops.storage_snapshot WHERE snapshot_ts = (SELECT max(snapshot_ts) FROM ops.storage_snapshot)",
          "format": "table",
          "rawQuery": true,
          "editorMode": "code"
        }
      ],
      "options": {
        "orientation": "vertical",
        "showValue": "auto",
        "groupWidth": 0.75,
        "barWidth": 0.9,
        "stacking": "none",
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi"
        },
        "xTickLabelRotation": -30
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "fillOpacity": 85,
            "lineWidth": 0
          },
          "unit": "decmbytes"
        },
        "overrides": []
      }
    },
    {
      "id": 11,
      "title": "Cumulative staging rows by domain after each refresh (history is appended, never truncated)",
      "type": "barchart",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "sdi-postgres"
      },
      "description": "",
      "gridPos": {
        "x": 0,
        "y": 17,
        "w": 12,
        "h": 10
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "sdi-postgres"
          },
          "rawSql": "WITH s AS (SELECT DISTINCT ON (refresh_tag, table_name) refresh_tag, domain, row_count\n                                 FROM ops.storage_snapshot WHERE layer='staging' AND refresh_tag IS NOT NULL\n                                 ORDER BY refresh_tag, table_name, snapshot_ts DESC)\n                      SELECT refresh_tag AS refresh,\n                        sum(row_count) FILTER (WHERE domain='Pharmacy sales') AS \"Pharmacy sales\",\n                        sum(row_count) FILTER (WHERE domain='IoT telemetry') AS \"IoT telemetry\",\n                        sum(row_count) FILTER (WHERE domain='Warehouse') AS \"Warehouse\",\n                        sum(row_count) FILTER (WHERE domain='Hospital demand') AS \"Hospital demand\",\n                        sum(row_count) FILTER (WHERE domain IN ('Manufacturing','Manufacturer delivery','Medicine master')) AS \"Mfg + delivery + master\"\n                      FROM s GROUP BY 1 ORDER BY 1",
          "format": "table",
          "rawQuery": true,
          "editorMode": "code"
        }
      ],
      "options": {
        "orientation": "vertical",
        "showValue": "auto",
        "groupWidth": 0.75,
        "barWidth": 0.9,
        "stacking": "normal",
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi"
        },
        "xTickLabelRotation": -30
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "fillOpacity": 85,
            "lineWidth": 0
          }
        },
        "overrides": []
      }
    },
    {
      "id": 12,
      "title": "Date coverage: rows per year-month (sales & hospital demand)",
      "type": "timeseries",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "sdi-postgres"
      },
      "description": "Every month 2023-01 \u2192 2026-02 is present (no holes). The January spikes are the year-start bulk postings flagged by the transform layer.",
      "gridPos": {
        "x": 12,
        "y": 17,
        "w": 12,
        "h": 10
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "sdi-postgres"
          },
          "rawSql": "SELECT to_date(year_month || '-01','YYYY-MM-DD')::timestamptz AS time, source_name AS metric,\n                               row_count AS value FROM ops.date_coverage\n                        WHERE snapshot_ts = (SELECT max(snapshot_ts) FROM ops.date_coverage)\n                          AND source_name IN ('05_pharmacy_sales_data','06_hospital_demand_data') ORDER BY 1",
          "format": "time_series",
          "rawQuery": true,
          "editorMode": "code"
        }
      ],
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
