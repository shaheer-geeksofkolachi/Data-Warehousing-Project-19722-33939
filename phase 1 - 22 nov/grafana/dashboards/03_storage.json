          "rawSql": "SELECT to_char(min_date,'YYYY-MM') || ' \u2192 ' || to_char(max_date,'YYYY-MM') ||\n                   ' (' || distinct_months || ' months)' FROM ops.storage_snapshot WHERE table_name='stg_pharmacy_sales_data'\n                   AND snapshot_ts = (SELECT max(snapshot_ts) FROM ops.storage_snapshot)",
